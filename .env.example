# Clé API OpenAI (côté serveur uniquement — ne jamais la mettre dans le front)
OPENAI_API_KEY=colle_ta_cle_api_ici
OPENAI_MODEL=gpt-4o-mini
# Voix neuronale premium (optionnel) : tts-1, tts-1-hd ou gpt-4o-mini-tts
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx
# Recherche Internet (optionnel). Sans clé, GRIOT utilise DuckDuckGo Instant Answer + Wikipédia.
TAVILY_API_KEY=
PORT=3000

# Moteur de conversation (optionnel) : "openjarvis" pour passer par OpenJarvis
# (lancez d'abord `jarvis serve`). La voix et Whisper continuent d'utiliser OPENAI_API_KEY.
GRIOT_AI_BACKEND=
OPENJARVIS_URL=http://127.0.0.1:8000/v1
OPENJARVIS_MODEL=
# Uniquement si OpenJarvis est protégé par une clé (OPENJARVIS_API_KEY côté jarvis)
OPENJARVIS_API_KEY=
